#!/bin/sh
# Refuse to push a personal identity, a tree with personal data, or a tree that fails the gates.
# Git passes one line per ref on stdin: <local ref> <local sha> <remote ref> <remote sha>.
# Run it by hand (sh .githooks/pre-push </dev/null) to get the same checks without pushing.
set -e
cd "$(git rev-parse --show-toplevel)"
exec node scripts/check-publication.mjs

#!/usr/bin/env node
import { spawn } from "node:child_process";
import { existsSync } from "node:fs";
import { dirname, join } from "node:path";
import { fileURLToPath } from "node:url";

const entry = join(dirname(fileURLToPath(import.meta.url)), "check-missing-cwd.bundle.mjs");
if (!existsSync(entry)) {
  console.error("CLI bundles are missing; run npm run build in the checkout before using this command.");
  process.exitCode = 1;
} else if (process.argv.slice(2).some(arg => arg === "--help" || arg === "-h")) {
  console.log("Usage: check-missing-cwd [--json]\nReport cards whose working directory is missing.");
} else {
  const child = spawn(process.execPath, [entry, ...process.argv.slice(2)], { stdio: "inherit" });
  child.on("error", error => { console.error(error.message); process.exitCode = 1; });
  for (const signal of ["SIGINT", "SIGTERM"]) process.on(signal, () => child.kill(signal));
  child.on("exit", (code, signal) => { process.exitCode = code ?? (signal ? 1 : 0); });
}
